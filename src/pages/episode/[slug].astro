---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import PlayButton from '../../components/PlayButton.astro';
import SpotifyButton from '../../components/SpotifyButton.astro';
import { getPodcast, type Episode } from '../../lib/feed';
import { episodeLabel, formatDate, formatDuration, formatTimestamp, sizedImage } from '../../lib/format';
import { absoluteUrl, episodeUrl, url } from '../../lib/links';
import { playData } from '../../lib/play';
import { tagSearchUrl } from '../../lib/search';
import { TAG_LABELS, type EpisodeTags } from '../../data/tags';

export async function getStaticPaths() {
  const { episodes } = await getPodcast();
  return episodes.map((episode, i) => ({
    params: { slug: episode.slug },
    props: { episode, newer: episodes[i - 1], older: episodes[i + 1] },
  }));
}

interface Props {
  episode: Episode;
  newer?: Episode;
  older?: Episode;
}

const { episode, newer, older } = Astro.props;
const tagGroups = (Object.keys(TAG_LABELS) as (keyof EpisodeTags)[])
  .filter((key) => episode.tags[key]?.length)
  .map((key) => ({ label: TAG_LABELS[key], values: episode.tags[key]! }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: episode.fullTitle,
  ...(episode.number !== null && { episodeNumber: episode.number }),
  datePublished: episode.date,
  description: episode.summary,
  image: episode.image,
  url: absoluteUrl(episodeUrl(episode)),
  timeRequired: `PT${Math.round(episode.duration / 60)}M`,
  associatedMedia: { '@type': 'MediaObject', contentUrl: episode.audioUrl },
  partOfSeries: { '@type': 'PodcastSeries', name: 'Spæll', url: absoluteUrl() },
};
---

<Base
  title={episode.fullTitle}
  description={episode.summary}
  image={sizedImage(episode.image, 'Large')}
  jsonLd={jsonLd}
  ogType="article"
>
  <article class="wrap episode">
    <div class="topnav">
      <a class="back" href={url('#episoder')}>← Alle episoder</a>
      <!-- Bla mellom episoder øverst, så det er lett å nå på mobil uten å scrolle til bunnen. -->
      <nav class="step" aria-label="Bla i episoder">
        {
          older ? (
            <a href={episodeUrl(older)} rel="prev" title={older.fullTitle} aria-label={`Forrige episode: ${older.fullTitle}`}>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
              Forrige<span class="long"> episode</span>
            </a>
          ) : (
            <span aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><path d="m15 6-6 6 6 6" /></svg>
              Forrige<span class="long"> episode</span>
            </span>
          )
        }
        {
          newer ? (
            <a href={episodeUrl(newer)} rel="next" title={newer.fullTitle} aria-label={`Neste episode: ${newer.fullTitle}`}>
              Neste<span class="long"> episode</span>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
            </a>
          ) : (
            <span aria-hidden="true">
              Neste<span class="long"> episode</span>
              <svg viewBox="0 0 24 24" width="16" height="16"><path d="m9 6 6 6-6 6" /></svg>
            </span>
          )
        }
      </nav>
    </div>

    <div class="content">
      <header>
        <Image src={sizedImage(episode.image, 'Medium')} alt="" width={360} height={360} widths={[208, 360, 600]} sizes="(max-width: 640px) 104px, 280px" loading="eager" fetchpriority="high" />
        <div>
          <span class={`badge badge-${episode.type}`}>{episodeLabel(episode)}</span>
          <h1>{episode.title}</h1>
          <p class="meta"><time datetime={episode.date}>{formatDate(episode.date)}</time> · {formatDuration(episode.duration)}</p>
          <div class="actions">
            <PlayButton episode={episode} />
            <SpotifyButton episode={episode} />
          </div>
        </div>
      </header>

      <div class="prose" set:html={episode.descriptionHtml} />

      <div class="aside">
      {
        tagGroups.length > 0 && (
          <section class="tags" aria-labelledby="tags">
            <h2 id="tags">Om episoden</h2>
            <dl>
              {tagGroups.map((group) => (
                <div>
                  <dt>{group.label}</dt>
                  <dd>
                    {group.values.map((value) => (
                      <a href={tagSearchUrl(value)} title={`Søk etter «${value}»`}>{value}</a>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        episode.chapters.length > 0 && (
          <section class="chapters" aria-labelledby="kapitler">
            <h2 id="kapitler">Kapitler</h2>
            <ol>
              {episode.chapters.map((c) => (
                <li>
                  <button
                    type="button"
                    {...playData(episode, { start: c.start })}
                  >
                    <span class="ts">{formatTimestamp(c.start)}</span>
                    {c.title}
                  </button>
                </li>
              ))}
            </ol>
          </section>
        )
      }
      </div>
    </div>

    <nav class="pager" aria-label="Flere episoder">
      {older ? <a href={episodeUrl(older)} rel="prev"><span class="meta">← Forrige episode</span>{older.fullTitle}</a> : <span />}
      {newer && <a class="newer" href={episodeUrl(newer)} rel="next"><span class="meta">Neste episode →</span>{newer.fullTitle}</a>}
    </nav>
  </article>
</Base>

<style>
  .episode { padding-top: 24px; }
  .topnav { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 24px; }
  .back { text-decoration: none; }
  .step { display: flex; gap: 6px; }
  .step > a, .step > span {
    display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px 6px 10px;
    font-size: 0.875rem; font-weight: 600; text-decoration: none; color: var(--text);
    border: 1px solid var(--border); border-radius: 999px;
  }
  .step > a[rel='next'], .step > span:last-child { padding: 6px 10px 6px 12px; }
  .step a:hover { color: var(--accent); border-color: var(--accent); }
  .step > span { opacity: 0.35; }
  .step svg { fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  header { display: grid; grid-template-columns: minmax(0, 280px) 1fr; gap: 32px; align-items: end; margin-bottom: 32px; }
  header img { border-radius: var(--radius); aspect-ratio: 1; object-fit: cover; }
  h1 { margin: 10px 0 6px; font-size: clamp(1.8rem, 4vw, 2.75rem); line-height: 1.1; }
  header .meta { margin: 0 0 18px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  /* Mobil: lite cover ved siden av tittelen, play-knappen i full bredde under. */
  @media (max-width: 640px) {
    .episode { padding-top: 16px; }
    .topnav { margin-bottom: 16px; }
    .step > a, .step > span { min-height: 36px; }
    .step .long { display: none; }
    header { grid-template-columns: 104px minmax(0, 1fr); gap: 0 16px; align-items: start; margin-bottom: 24px; }
    header > div { display: contents; }
    header img { grid-row: 1 / span 3; }
    header .badge, h1, header .meta { grid-column: 2; justify-self: start; }
    h1 { margin: 6px 0 4px; font-size: 1.4rem; }
    header .meta { margin: 0; font-size: 0.8rem; }
    .actions { grid-column: 1 / -1; margin-top: 16px; }
    .actions :global(.btn) { flex: 1; justify-content: center; }
    .prose { font-size: 1rem; }
  }

  /* Desktop: «Om episoden» og kapitler står i egen kolonne fra toppen, ved siden av tittelen. */
  /* Rad 2 er 1fr, så en høy sidekolonne (mange kapitler) gjør beskrivelsens rad høyere, ikke tittelens. */
  .content { display: grid; grid-template-columns: minmax(0, 1fr) 320px; grid-template-rows: auto 1fr; column-gap: 40px; align-items: start; }
  header, .prose { grid-column: 1; }
  .aside { grid-column: 2; grid-row: 1 / span 2; }
  .prose { max-width: 68ch; font-size: 1.05rem; }
  /* Smalere: én kolonne i rekkefølgen tittel, beskrivelse, «Om episoden» og kapitler. */
  @media (max-width: 900px) {
    .content { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; }
    .aside { grid-column: 1; grid-row: auto; margin-top: 40px; }
  }

  .aside { display: grid; gap: 16px; }
  .tags { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }
  .tags h2 { margin: 0 0 12px; font-size: 1.1rem; }
  .tags dl { display: grid; gap: 10px; margin: 0; }
  .tags dt { margin-bottom: 4px; color: var(--muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .tags dd { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .tags a {
    padding: 4px 10px; border-radius: 999px; font-size: 0.85rem; font-weight: 550; text-decoration: none;
    color: var(--text); background: var(--surface-2); border: 1px solid transparent;
  }
  .tags a:hover { color: var(--accent); border-color: var(--accent); }
  .chapters { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }
  .chapters h2 { margin: 0 0 8px; font-size: 1.1rem; }
  .chapters ol { list-style: none; margin: 0; padding: 0; }
  .chapters button {
    display: flex; gap: 12px; width: 100%; text-align: left;
    background: transparent; border: 0; border-radius: 8px; padding: 8px;
  }
  .chapters button:hover { background: var(--surface-2); }
  .ts { color: var(--accent); font-variant-numeric: tabular-nums; min-width: 4.5em; }

  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 48px; border-top: 1px solid var(--border); padding-top: 24px; }
  .pager a { display: flex; flex-direction: column; text-decoration: none; color: var(--text); max-width: 45%; }
  .pager a:hover { color: var(--accent); }
  .newer { text-align: right; margin-left: auto; }
</style>
