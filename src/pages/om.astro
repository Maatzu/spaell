---
import Base from '../layouts/Base.astro';
import { getPodcast } from '../lib/feed';
import { sizedImage } from '../lib/format';
import { LISTEN_LINKS, PATREON_URL, SOCIAL_LINKS } from '../lib/links';

const podcast = await getPodcast();
const numbered = podcast.episodes.filter((e) => e.number !== null);
const firstYear = podcast.episodes.at(-1)!.year;
const linkSections = [
  { heading: 'Lytt', links: LISTEN_LINKS },
  { heading: 'Følg Spæll', links: SOCIAL_LINKS },
];
const totalHours = Math.round(podcast.episodes.reduce((sum, e) => sum + e.duration, 0) / 3600);
---

<Base title="Om Spæll">
  <article class="wrap about">
    <img src={sizedImage(podcast.image, 'Large')} alt="Spæll-logoen" width="240" height="240" />
    <div class="prose">
      <p class="greeting" aria-hidden="true">Hallais!</p>
      <h1>Om Spæll</h1>
      <p class="lead">{podcast.description}</p>
      <p>
        Spæll er en norsk spillpodcast med <strong>Adrian</strong> og <strong>Håkon</strong>, ofte med gjester fra
        andre podcaster og spillmiljøet. Podcasten startet som «Spæll-Linja» og har sluppet episoder siden {firstYear}.
      </p>
      <ul class="stats">
        <li><strong>{podcast.episodes.length}</strong> episoder totalt</li>
        <li><strong>{numbered.length}</strong> nummererte episoder</li>
        <li><strong>{totalHours}</strong> timer med spillprat</li>
      </ul>

      <aside class="support" aria-labelledby="stott">
        <h2 id="stott">Støtt Spæll på Patreon</h2>
        <p>
          Adrian og Håkon lager Spæll på fritiden, av ren kjærlighet til spill. Liker du det du hører, er Patreon den
          beste måten å gi noe tilbake på. Der får du reklamefrie episoder og tilgang til bonuspodcasten{' '}
          <strong>NachSpæll</strong>, og du hjelper gutta med å holde det gående.
        </p>
        <p>
          Ikke la deg forvirre av navnet: Spæll er en del av podcastfamilien <strong>LOLbua</strong>, så Patreon-siden
          heter LOLbua. Støtter du der, støtter du også Spæll.
        </p>
        <a class="btn" href={PATREON_URL} target="_blank" rel="noopener">Støtt via LOLbua på Patreon</a>
      </aside>

      {
        linkSections.map(({ heading, links }) => (
          <>
            <h2>{heading}</h2>
            <p>{links.map((l, i) => <>{i > 0 && ' · '}<a href={l.href} target="_blank" rel="noopener">{l.label}</a></>)}</p>
          </>
        ))
      }

      <h2>Om denne siden</h2>
      <p class="meta">
        Dette er en uoffisiell fanside. Episodelista hentes automatisk fra Spælls RSS-feed, og lyden spilles direkte
        fra podcastens egen hosting.
      </p>
    </div>
  </article>
</Base>

<style>
  .about { display: grid; grid-template-columns: 240px minmax(0, 68ch); gap: 40px; padding-top: 40px; }
  .about img { border-radius: var(--radius); aspect-ratio: 1; object-fit: cover; }
  h1 { margin-top: 0; font-size: 2.5rem; }
  .greeting {
    margin: 0 0 4px; font-size: clamp(2.5rem, 7vw, 4rem); font-weight: 900; font-style: italic; line-height: 1;
    color: var(--red); -webkit-text-stroke: 2px var(--text); paint-order: stroke fill; letter-spacing: -0.02em;
    transform: rotate(-3deg); transform-origin: left bottom;
  }
  .lead { font-size: 1.2rem; }
  .support {
    margin: 32px 0; padding: 20px 24px; border-radius: var(--radius);
    background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--red);
  }
  .support h2 { margin-top: 0; }
  .support .btn { margin-top: 4px; }
  .stats { display: flex; flex-wrap: wrap; gap: 12px; list-style: none; padding: 0; }
  .stats li { background: var(--surface); border: 1px solid var(--border); border-top: 3px solid var(--red); border-radius: var(--radius); padding: 12px 16px; }
  .stats strong { display: block; font-size: 1.5rem; color: var(--accent); }
  @media (max-width: 720px) {
    .about { grid-template-columns: 1fr; }
    .about img { max-width: 160px; }
  }
</style>
