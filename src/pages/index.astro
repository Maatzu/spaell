---
import Base from '../layouts/Base.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import PlayButton from '../components/PlayButton.astro';
import { FEED_URL, getPodcast, formatDate, formatDuration, sizedImage, TYPE_LABEL } from '../lib/feed';
import { url } from '../lib/links';

const podcast = await getPodcast();
const [latest] = podcast.episodes;
const years = [...new Set(podcast.episodes.map((e) => e.year))];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: podcast.title,
  description: podcast.description,
  image: podcast.image,
  inLanguage: 'no',
  webFeed: FEED_URL,
  url: new URL(url(), Astro.site).href,
};
---

<Base description={podcast.description} image={sizedImage(podcast.image, 'Large')} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-inner">
      <a href={url(`episode/${latest.slug}/`)} class="hero-cover">
        <img src={sizedImage(latest.image, 'Large')} alt="" width="480" height="480" />
      </a>
      <div class="hero-text">
        <p class="eyebrow">Siste episode</p>
        <h1><a href={url(`episode/${latest.slug}/`)}>{latest.title}</a></h1>
        <p class="meta">
          {latest.number !== null ? `#${latest.number}` : TYPE_LABEL[latest.type]}{' · '}
          <time datetime={latest.date}>{formatDate(latest.date)}</time> · {formatDuration(latest.duration)}
        </p>
        <p class="summary">{latest.summary}</p>
        <div class="actions">
          <PlayButton episode={latest} />
          <a class="btn btn-ghost" href={url(`episode/${latest.slug}/`)}>Les mer</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap episodes" aria-labelledby="alle">
    <div class="toolbar">
      <h2 id="alle">Alle episoder <span class="meta" data-count>({podcast.episodes.length})</span></h2>
      <div class="filters" role="search">
        <label class="visually-hidden" for="q">Søk</label>
        <input id="q" type="search" placeholder="Søk etter spill, gjester …" autocomplete="off" />
        <label class="visually-hidden" for="year">År</label>
        <select id="year">
          <option value="">Alle år</option>
          {years.map((y) => <option value={y}>{y}</option>)}
        </select>
        <label class="visually-hidden" for="type">Type</label>
        <select id="type">
          <option value="">Alle typer</option>
          <option value="episode">Episoder</option>
          <option value="spaellbreak">SpællBreak</option>
          <option value="spesial">Spesial</option>
        </select>
        <label class="visually-hidden" for="sort">Sortering</label>
        <select id="sort">
          <option value="new">Nyeste først</option>
          <option value="old">Eldste først</option>
        </select>
      </div>
    </div>

    <ul class="grid" data-grid>
      {podcast.episodes.map((episode) => <EpisodeCard episode={episode} />)}
    </ul>
    <p class="empty" data-empty hidden>Ingen episoder passer søket.</p>
  </section>
</Base>

<script>
  function setupFilters() {
    const grid = document.querySelector<HTMLElement>('[data-grid]');
    if (!grid) return;
    const q = document.querySelector<HTMLInputElement>('#q')!;
    const year = document.querySelector<HTMLSelectElement>('#year')!;
    const type = document.querySelector<HTMLSelectElement>('#type')!;
    const sort = document.querySelector<HTMLSelectElement>('#sort')!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];

    function apply() {
      const terms = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const card of cards) {
        const d = card.dataset;
        const show =
          terms.every((t) => d.search!.includes(t)) &&
          (!year.value || d.year === year.value) &&
          (!type.value || d.type === type.value);
        card.hidden = !show;
        if (show) visible++;
      }
      const ordered = sort.value === 'old' ? [...cards].reverse() : cards;
      if (grid!.firstElementChild !== ordered[0]) grid!.append(...ordered);
      count.textContent = `(${visible})`;
      empty.hidden = visible > 0;
    }

    [q, year, type, sort].forEach((el) => el.addEventListener('input', apply));
    apply();
  }

  document.addEventListener('astro:page-load', setupFilters);
</script>

<style>
  .hero { padding-block: 48px; background: radial-gradient(ellipse at top left, #2a2010 0%, transparent 60%); }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 320px) 1fr; gap: 40px; align-items: center; }
  .hero-cover img { border-radius: var(--radius); box-shadow: 0 20px 60px rgb(0 0 0 / 0.5); aspect-ratio: 1; object-fit: cover; }
  .eyebrow { margin: 0; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; }
  h1 { margin: 6px 0 8px; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.1; }
  h1 a { color: inherit; text-decoration: none; }
  .summary { color: var(--muted); max-width: 60ch; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }
  @media (max-width: 720px) {
    .hero-inner { grid-template-columns: 1fr; gap: 24px; }
    .hero-cover { max-width: 240px; }
  }

  .episodes { padding-top: 24px; }
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
  h2 { margin: 0; font-size: 1.5rem; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .filters input, .filters select {
    font: inherit; color: var(--text); background: var(--surface); border: 1px solid var(--border);
    border-radius: 999px; padding: 8px 14px;
  }
  .filters input { width: min(280px, 100%); }
  @media (max-width: 640px) {
    .filters { width: 100%; }
    .filters input { width: 100%; }
    .filters select { flex: 1; }
  }

  .grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 16px;
    padding: 0; margin: 0;
  }
  .grid :global([hidden]) { display: none; }
  @media (max-width: 420px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } }
  .empty { color: var(--muted); text-align: center; padding: 40px 0; }
</style>
