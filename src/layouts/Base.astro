---
import { ClientRouter } from 'astro:transitions';
import Player from '../components/Player.astro';
import { LISTEN_LINKS, SOCIAL_LINKS, url } from '../lib/links';
import { getPodcast, sizedImage } from '../lib/feed';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
  image: string;
  /** JSON-LD for strukturert data. */
  jsonLd?: object;
  ogType?: 'website' | 'article';
}

const { title, description, image, jsonLd, ogType = 'website' } = Astro.props;
const fullTitle = title ? `${title} – Spæll` : 'Spæll – podcasten om gamle og nye spill';
const canonical = new URL(Astro.url.pathname, Astro.site);
const podcast = await getPodcast();
---

<!doctype html>
<html lang="no">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#0d0d0f" />
    <script is:inline>
      // Setter tema før siden tegnes, og på nytt etter hvert sidebytte i ClientRouter. Mørkt er standard.
      (() => {
        const stored = () => {
          try {
            return localStorage.getItem('spaell:theme');
          } catch {
            return null;
          }
        };
        const apply = () => {
          const theme = stored() === 'light' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name=theme-color]')?.setAttribute('content', theme === 'light' ? '#f4f4f6' : '#0d0d0f');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
        // Temaet tones over til det nye.
        window.toggleTheme = () => {
          const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          const update = () => {
            try {
              localStorage.setItem('spaell:theme', next);
            } catch {}
            apply();
          };
          if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return update();
          try {
            document.startViewTransition({ update, types: ['theme'] });
          } catch {
            document.startViewTransition(update);
          }
        };
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Spæll" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <ClientRouter />

    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://spaell.goatcounter.com/count"
          data-goatcounter-settings='{"no_onload": true}'
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
    <script is:inline>
      // GoatCounter teller hver sidevisning, også de som skjer via ClientRouter.
      document.addEventListener('astro:page-load', () => {
        const count = () => window.goatcounter?.count?.({ path: location.pathname });
        if (window.goatcounter?.count) count();
        else window.addEventListener('load', count, { once: true });
      });
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={url()}>
          <img src={sizedImage(podcast.image, 'Thumbnail')} alt="" width="32" height="32" />
          Spæll
        </a>
        <nav aria-label="Hovedmeny" class="nav">
          <a href={url()}>Episoder</a>
          <a href={url('om/')}>Om</a>
        </nav>
        <nav aria-label="Lytt" class="listen">
          {LISTEN_LINKS.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
        </nav>
        <button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Bytt mellom lyst og mørkt tema">
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <ul class="social">
          {SOCIAL_LINKS.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
        </ul>
        <p class="meta">
          Uoffisiell fanside, laget med kjærlighet til Spæll. Alt innhold og all lyd tilhører Spæll.
        </p>
      </div>
    </footer>

    <Player />
  </body>
</html>

<style>
  .site-header {
    border-bottom: 2px solid var(--red);
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    position: sticky; top: 0; z-index: 10;
    view-transition-name: site-header;
  }
  .header-inner { display: flex; align-items: center; gap: 24px; min-height: 64px; flex-wrap: wrap; padding-block: 8px; }
  .logo img { border-radius: 6px; }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.25rem; color: var(--text); text-decoration: none; }
  .nav, .listen { display: flex; gap: 16px; }
  .nav a { color: var(--text); text-decoration: none; font-weight: 550; }
  .nav a:hover { color: var(--accent); }
  .listen { margin-left: auto; gap: 8px; }
  .theme-toggle {
    display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0;
    border: 1px solid var(--border); border-radius: 999px; background: transparent; color: var(--text);
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  .theme-toggle svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .icon-moon, :global([data-theme='light']) .icon-sun { display: none; }
  :global([data-theme='light']) .icon-moon { display: block; }
  .listen a {
    font-size: 0.85rem; text-decoration: none; color: var(--text);
    padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px;
  }
  .listen a:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 640px) {
    .theme-toggle { margin-left: auto; }
    .listen { order: 1; margin-left: 0; width: 100%; overflow-x: auto; }
  }

  main { min-height: 60vh; }

  .site-footer { border-top: 1px solid var(--border); margin-top: 64px; padding-block: 32px; }
  .social { list-style: none; padding: 0; margin: 0 0 12px; display: flex; flex-wrap: wrap; gap: 8px 20px; }
</style>
