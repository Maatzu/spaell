---
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import LinkIcon from '../components/LinkIcon.astro';
import Player from '../components/Player.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getPodcast } from '../lib/feed';
import { sizedImage } from '../lib/format';
import { LISTEN_LINKS, absoluteUrl, url } from '../lib/links';
import '../styles/global.css';

interface Props {
  title?: string;
  /** Standard er podcastens beskrivelse. */
  description?: string;
  /** Delingsbilde. Standard er podcastens logo. */
  image?: string;
  /** JSON-LD for strukturert data. */
  jsonLd?: object;
  ogType?: 'website' | 'article';
}

const podcast = await getPodcast();
const {
  title,
  description = podcast.description,
  image = sizedImage(podcast.image, 'Large'),
  jsonLd,
  ogType = 'website',
} = Astro.props;
const fullTitle = title ? `${title} – Spæll` : 'Spæll – podcasten om gamle og nye spill';
const canonical = absoluteUrl(Astro.url.pathname);
// Første del av stien etter base, for å markere aktiv meny.
const section = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length).split('/')[1];
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.png')} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#0d0d0f" />
    <script is:inline>
      // Setter tema før siden tegnes, på nytt etter hvert sidebytte i ClientRouter, og når
      // ThemeToggle sender «spaell:theme». Mørkt er standard.
      (() => {
        const stored = () => {
          try {
            return localStorage.getItem('spaell:theme');
          } catch {
            return null;
          }
        };
        const apply = () => {
          const theme = stored() === 'light' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name=theme-color]')?.setAttribute('content', theme === 'light' ? '#f4f4f6' : '#0d0d0f');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
        document.addEventListener('spaell:theme', apply);
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Spæll" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <ClientRouter />

    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://spaell.goatcounter.com/count"
          data-goatcounter-settings='{"no_onload": true}'
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
    <script is:inline>
      // GoatCounter teller hver sidevisning, også de som skjer via ClientRouter.
      document.addEventListener('astro:page-load', () => {
        const count = () => window.goatcounter?.count?.({ path: location.pathname });
        if (window.goatcounter?.count) count();
        else window.addEventListener('load', count, { once: true });
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#innhold">Hopp til innhold</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href={url()}>
          <Image src={sizedImage(podcast.image, 'Small')} alt="" width={32} height={32} densities={[1, 2]} loading="eager" />
          <span class="logo-text">Spæll</span>
        </a>
        <nav aria-label="Hovedmeny" class="nav">
          <a href={url('#episoder')} aria-current={section === 'episode' ? 'page' : undefined}>Episoder</a>
          <a href={url('om/')} aria-current={section === 'om' ? 'page' : undefined}>Om</a>
        </nav>
        <nav aria-label="Lytt" class="listen">
          {LISTEN_LINKS.map((l) => <a href={l.href} target="_blank" rel="noopener" title={l.label}><LinkIcon name={l.icon} size={14} /><span class="listen-label">{l.label}</span></a>)}
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <main id="innhold">
      <slot />
    </main>

    <Player />
  </body>
</html>

<script>
  import { withViewTransition } from '../lib/transition';

  // Lenker til et anker på samme side (som «Episoder» i menyen) glir dit med en view transition
  // i stedet for å hoppe. Lytter i capture-fasen og kaller preventDefault, så ClientRouter lar klikket være.
  addEventListener(
    'click',
    (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
      if (!link || link.pathname !== location.pathname || !link.hash) return;
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (!target) return;
      e.preventDefault();
      const down = target.getBoundingClientRect().top > 0;
      withViewTransition(
        () => {
          target.scrollIntoView();
          history.pushState(history.state, '', link.hash);
        },
        'jump',
        down ? 'jump-down' : 'jump-up',
      );
    },
    true,
  );
</script>

<style>
  .site-header {
    border-bottom: 2px solid var(--red);
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    position: sticky; top: 0; z-index: 10;
    view-transition-name: site-header;
  }
  .header-inner { display: flex; align-items: center; gap: 24px; min-height: 64px; flex-wrap: wrap; padding-block: 8px; }
  .logo img { border-radius: 6px; }
  /* Omny leverer logoen som JPEG med hvit bakgrunn; i lyst tema smelter den inn i headeren. */
  :global([data-theme='light']) .logo img { mix-blend-mode: multiply; }
  .logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.25rem; color: var(--text); text-decoration: none; }
  .nav, .listen { display: flex; gap: 16px; }
  .nav a { color: var(--text); text-decoration: none; font-weight: 550; }
  .nav a:hover, .nav a[aria-current='page'] { color: var(--accent); }
  .listen { margin-left: auto; gap: 8px; }
  .listen a {
    display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
    font-size: 0.85rem; text-decoration: none; color: var(--text);
    padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px;
  }
  .listen a:hover { border-color: var(--accent); color: var(--accent); }
  /* På smale skjermer holdes headeren på én rad: lytteknappene blir runde ikoner. */
  @media (max-width: 760px) {
    .header-inner { flex-wrap: nowrap; gap: 14px; min-height: 56px; }
    .nav { gap: 14px; }
    .listen { gap: 6px; }
    .listen a { width: 34px; height: 34px; padding: 0; justify-content: center; }
    .listen a :global(svg) { width: 16px; height: 16px; }
    .listen-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (max-width: 420px) {
    .logo-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .header-inner { gap: 12px; }
  }

  main { min-height: 60vh; padding-bottom: 64px; }
  .skip-link {
    position: fixed; top: 8px; left: 8px; z-index: 30; padding: 10px 16px; border-radius: 999px;
    background: var(--red); color: var(--accent-ink); font-weight: 700; text-decoration: none;
    translate: 0 -200%;
  }
  .skip-link:focus { translate: 0 0; }

</style>
