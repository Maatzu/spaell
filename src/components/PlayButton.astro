---
import type { Episode } from '../lib/feed';
import { sizedImage } from '../lib/feed';
import { url } from '../lib/links';

interface Props {
  episode: Episode;
  class?: string;
}

const { episode, class: className = 'btn' } = Astro.props;
---

<button
  type="button"
  class={className}
  data-play={episode.id}
  data-src={episode.audioUrl}
  data-title={episode.fullTitle}
  data-image={sizedImage(episode.image, 'Small')}
  data-href={url(`episode/${episode.slug}/`)}
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
  <span data-play-label>Spill av</span>
</button>
