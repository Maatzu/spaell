---
import { Image } from 'astro:assets';
import PlayPauseIcon from './PlayPauseIcon.astro';
import type { Episode } from '../lib/feed';
import { episodeLabel, formatDate, formatDuration, sizedImage } from '../lib/format';
import { episodeUrl } from '../lib/links';
import { playData } from '../lib/play';

interface Props {
  episode: Episode;
  /** Kort som synes uten å scrolle lastes med en gang i stedet for «lazy». */
  eager?: boolean;
}

const { episode, eager = false } = Astro.props;
const search = `${episode.fullTitle} ${episode.text} ${Object.values(episode.tags).flat().join(' ')}`.toLowerCase();
// Nummererte episoder får en nøytral badge; de andre farges etter type.
const badgeClass = episode.number !== null ? 'badge' : `badge badge-${episode.type}`;
---

<li class="card" data-search={search} data-year={episode.year} data-type={episode.type}>
  <button
    type="button"
    class="cover"
    {...playData(episode)}
    aria-label={`Spill av ${episode.fullTitle}`}
  >
    <Image src={sizedImage(episode.image, 'Medium')} alt="" width={400} height={400} widths={[200, 400]} sizes="(max-width: 420px) 50vw, 200px" loading={eager ? 'eager' : 'lazy'} />
    <span class="play" aria-hidden="true">
      <PlayPauseIcon size={26} />
    </span>
  </button>
  <a class="body" href={episodeUrl(episode)}>
    <span class="tags">
      <span class={badgeClass}>{episodeLabel(episode)}</span>
      <span class="meta">{formatDuration(episode.duration)}</span>
    </span>
    <h3>{episode.title}</h3>
    <time class="meta" datetime={episode.date}>{formatDate(episode.date, 'short')}</time>
  </a>
</li>

<style>
  .card {
    list-style: none; display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover { transform: translateY(-2px); border-color: var(--red); box-shadow: 0 8px 24px rgb(200 0 10 / 0.2); }

  .cover { position: relative; display: block; padding: 0; border: 0; background: var(--surface-2); }
  .cover img { aspect-ratio: 1; width: 100%; object-fit: cover; transition: filter 0.15s ease; }
  .play {
    position: absolute; inset: 0; margin: auto; width: 56px; height: 56px;
    display: grid; place-items: center; border-radius: 999px;
    background: var(--red); color: #fff; box-shadow: 0 6px 20px rgb(0 0 0 / 0.5);
    opacity: 0; scale: 0.85; transition: opacity 0.15s ease, scale 0.15s ease;
  }
  .cover:hover img, .cover:focus-visible img, .cover.is-playing img { filter: brightness(0.7); }
  .cover:hover .play, .cover:focus-visible .play, .cover.is-playing .play { opacity: 1; scale: 1; }
  /* Uten hover (mobil) vises en liten play-knapp i hjørnet hele tiden. */
  @media (hover: none) {
    .play { opacity: 1; scale: 1; inset: auto 8px 8px auto; width: 40px; height: 40px; }
    .play :global(svg) { width: 20px; height: 20px; }
  }

  .body {
    flex: 1; display: flex; flex-direction: column; gap: 6px; padding: 12px 14px 14px;
    color: var(--text); text-decoration: none;
  }
  .body:hover h3 { color: var(--accent); }
  h3 { margin: 0; font-size: 1rem; line-height: 1.3; }
  .tags { display: flex; justify-content: space-between; align-items: center; gap: 8px; white-space: nowrap; }
  time { margin-top: auto; }
</style>
