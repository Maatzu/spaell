---
import type { Episode } from '../lib/feed';
import { TYPE_LABEL, formatDate, formatDuration, sizedImage } from '../lib/feed';
import { url } from '../lib/links';

interface Props {
  episode: Episode;
}

const { episode } = Astro.props;
const search = `${episode.fullTitle} ${episode.text}`.toLowerCase();
---

<li class="card" data-search={search} data-year={episode.year} data-type={episode.type} data-date={episode.date}>
  <a href={url(`episode/${episode.slug}/`)}>
    <img src={sizedImage(episode.image, 'Medium')} alt="" width="400" height="400" loading="lazy" decoding="async" />
    <div class="body">
      <div class="tags">
        {episode.number !== null ? <span class="badge">#{episode.number}</span> : <span class={`badge badge-${episode.type}`}>{TYPE_LABEL[episode.type]}</span>}
      </div>
      <h3>{episode.title}</h3>
      <p class="meta"><time datetime={episode.date}>{formatDate(episode.date)}</time> · {formatDuration(episode.duration)}</p>
    </div>
  </a>
</li>

<style>
  .card { list-style: none; }
  .card a {
    display: flex; flex-direction: column; height: 100%;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    overflow: hidden; color: var(--text); text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .card a:hover { transform: translateY(-2px); border-color: var(--red); box-shadow: 0 8px 24px rgb(200 0 10 / 0.2); }
  img { aspect-ratio: 1; width: 100%; height: auto; object-fit: cover; background: var(--surface-2); }
  .body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; }
  h3 { margin: 0; font-size: 1rem; line-height: 1.3; }
  .meta { margin: 0; }
</style>
