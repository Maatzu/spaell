---
/*
 * Bytter mellom lyst og mørkt tema. Selve temaet settes av det inline skriptet i
 * Base.astro, som lytter etter «spaell:theme» og leser valget fra localStorage.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Bytt mellom lyst og mørkt tema">
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
</button>

<script>
  import { withViewTransition } from '../lib/transition';

  // Lytter på document, så knappen virker også etter sidebytter i ClientRouter.
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('[data-theme-toggle]')) return;
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    withViewTransition(() => {
      try {
        localStorage.setItem('spaell:theme', next);
      } catch {}
      document.dispatchEvent(new Event('spaell:theme'));
    }, 'theme');
  });
</script>

<style>
  .theme-toggle {
    display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0;
    border: 1px solid var(--border); border-radius: 999px; background: transparent; color: var(--text);
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }
  .theme-toggle svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .icon-moon, :global([data-theme='light']) .icon-sun { display: none; }
  :global([data-theme='light']) .icon-moon { display: block; }
</style>
