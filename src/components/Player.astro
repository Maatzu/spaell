---
import PlayPauseIcon from './PlayPauseIcon.astro';

/*
 * Avspilleren ligger nederst og overlever sidebytter (transition:persist).
 * Alle elementer med data-play starter en episode:
 *   data-play="<id>" data-src data-title data-image data-href data-duration [data-chapters=JSON] [data-start=sekunder]
 * Attributtene lages av playData() og leses av readTrack() i src/lib/play.ts.
 */
---

<div id="player" class="player" transition:persist hidden>
  <audio preload="none"></audio>
  <a class="cover" data-link><img alt="" width="56" height="56" /></a>
  <div class="info">
    <div class="heading">
      <a class="title" data-link></a>
      <span class="chapter" data-chapter></span>
    </div>
    <div class="scrub">
      <span class="time" data-current>0:00</span>
      <div class="track">
        <input type="range" min="0" max="0" step="1" value="0" aria-label="Posisjon i episoden" />
        <div class="markers" data-markers aria-hidden="true"></div>
      </div>
      <span class="time" data-duration>0:00</span>
    </div>
  </div>
  <div class="controls">
    <button type="button" data-skip="-15" aria-label="Spol 15 sekunder tilbake">−15</button>
    <button type="button" class="toggle" data-toggle aria-label="Spill av">
      <PlayPauseIcon size={24} />
    </button>
    <button type="button" data-skip="30" aria-label="Spol 30 sekunder frem">+30</button>
    <button type="button" class="speed" data-speed aria-label="Avspillingshastighet">1×</button>
    <div class="chapters-menu">
      <button type="button" class="chapters-toggle" data-chapters-toggle aria-label="Kapitler" aria-expanded="false" aria-controls="player-chapters" hidden>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
      </button>
      <ol class="chapter-list" id="player-chapters" data-chapter-list hidden></ol>
    </div>
  </div>
</div>

<script>
  import { formatTimestamp } from '../lib/format';
  import { readTrack, type Track } from '../lib/play';

  const STORAGE_PREFIX = 'spaell:';
  const SPEEDS = [1, 1.25, 1.5, 1.75, 2];

  const store = {
    get<T>(key: string): T | null {
      try {
        const v = localStorage.getItem(STORAGE_PREFIX + key);
        return v === null ? null : (JSON.parse(v) as T);
      } catch {
        return null;
      }
    },
    set(key: string, value: unknown) {
      try {
        localStorage.setItem(STORAGE_PREFIX + key, JSON.stringify(value));
      } catch {}
    },
  };

  const root = document.getElementById('player')!;
  const audio = root.querySelector('audio')!;
  const range = root.querySelector<HTMLInputElement>('input[type=range]')!;
  const current = root.querySelector<HTMLElement>('[data-current]')!;
  const total = root.querySelector<HTMLElement>('[data-duration]')!;
  const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
  const speedBtn = root.querySelector<HTMLButtonElement>('[data-speed]')!;
  const chapterLabel = root.querySelector<HTMLElement>('[data-chapter]')!;
  const markers = root.querySelector<HTMLElement>('[data-markers]')!;
  const chaptersToggle = root.querySelector<HTMLButtonElement>('[data-chapters-toggle]')!;
  const chapterList = root.querySelector<HTMLOListElement>('[data-chapter-list]')!;
  let track: Track | null = null;
  let lastSaved = 0;
  let activeChapter = -1;

  function savePosition() {
    if (track) store.set(`pos:${track.id}`, Math.floor(audio.currentTime));
  }

  function renderChapters() {
    const chapters = track?.chapters ?? [];
    chaptersToggle.hidden = chapters.length === 0;
    setChapterListOpen(false);
    chapterList.replaceChildren(
      ...chapters.map((c, i) => {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.index = String(i);
        const ts = document.createElement('span');
        ts.className = 'ts';
        ts.textContent = formatTimestamp(c.start);
        btn.append(ts, c.title);
        li.append(btn);
        return li;
      }),
    );
    renderMarkers();
    activeChapter = -1;
    updateChapter();
  }

  function renderMarkers() {
    const chapters = track?.chapters ?? [];
    // Før lyden er lastet bruker vi varigheten fra feeden.
    const duration = audio.duration || track?.duration || 0;
    markers.replaceChildren(
      ...(duration > 0 ? chapters.slice(1) : []).map((c) => {
        const tick = document.createElement('span');
        tick.style.left = `${(c.start / duration) * 100}%`;
        return tick;
      }),
    );
  }

  function updateChapter(time = audio.currentTime) {
    const chapters = track?.chapters ?? [];
    let index = -1;
    for (let i = 0; i < chapters.length; i++) if (chapters[i].start <= time) index = i;
    if (index === activeChapter) return;
    activeChapter = index;
    // Første kapittel heter ofte det samme som episoden; da viser vi det ikke to ganger.
    const title = index >= 0 ? chapters[index].title : '';
    chapterLabel.textContent = title === track?.title ? '' : title;
    chapterList.querySelectorAll('button').forEach((b, i) => b.classList.toggle('is-active', i === index));
  }

  function setChapterListOpen(open: boolean) {
    chapterList.hidden = !open;
    chaptersToggle.setAttribute('aria-expanded', String(open));
  }

  function load(next: Track, start?: number) {
    if (track?.id !== next.id) {
      savePosition();
      track = next;
      audio.src = next.src;
      store.set('current', next);
      root.querySelector('img')!.src = next.image;
      root.querySelectorAll<HTMLAnchorElement>('[data-link]').forEach((a) => (a.href = next.href));
      root.querySelector('.title')!.textContent = next.title;
      range.max = String(next.duration);
      total.textContent = formatTimestamp(next.duration);
      renderChapters();
      root.hidden = false;
      const resumeAt = start ?? store.get<number>(`pos:${next.id}`) ?? 0;
      range.value = String(resumeAt);
      current.textContent = formatTimestamp(resumeAt);
      updateChapter(resumeAt);
      audio.addEventListener('loadedmetadata', () => (audio.currentTime = resumeAt), { once: true });
    } else if (start !== undefined) {
      audio.currentTime = start;
    }
  }

  function togglePlayback() {
    if (audio.paused) audio.play();
    else audio.pause();
  }

  function syncButtons() {
    const playing = !audio.paused;
    root.classList.toggle('is-playing', playing);
    toggle.setAttribute('aria-label', playing ? 'Pause' : 'Spill av');
    document.querySelectorAll<HTMLElement>('[data-play]:not([data-start])').forEach((el) => {
      const active = playing && el.dataset.play === track?.id;
      el.classList.toggle('is-playing', active);
      const label = el.querySelector('[data-play-label]');
      if (label) label.textContent = active ? 'Pause' : 'Spill av';
    });
  }

  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest<HTMLElement>('[data-play]');
    if (!el) return;
    e.preventDefault();
    const start = el.dataset.start !== undefined ? Number(el.dataset.start) : undefined;
    if (el.dataset.play === track?.id && start === undefined) return togglePlayback();
    load(readTrack(el.dataset), start);
    audio.play();
  });

  toggle.addEventListener('click', togglePlayback);
  root.querySelectorAll<HTMLButtonElement>('[data-skip]').forEach((b) =>
    b.addEventListener('click', () => (audio.currentTime += Number(b.dataset.skip))),
  );
  speedBtn.addEventListener('click', () => {
    const next = SPEEDS[(SPEEDS.indexOf(audio.playbackRate) + 1) % SPEEDS.length];
    audio.playbackRate = next;
    speedBtn.textContent = `${next}×`;
    store.set('speed', next);
  });
  range.addEventListener('input', () => (audio.currentTime = Number(range.value)));

  chaptersToggle.addEventListener('click', () => setChapterListOpen(chapterList.hidden));
  chapterList.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-index]');
    if (!btn || !track) return;
    audio.currentTime = track.chapters[Number(btn.dataset.index)].start;
    audio.play();
    setChapterListOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (!chapterList.hidden && !(e.target as Element).closest('.chapters-menu')) setChapterListOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !chapterList.hidden) {
      setChapterListOpen(false);
      chaptersToggle.focus();
    }
  });

  audio.addEventListener('play', () => {
    audio.playbackRate = store.get<number>('speed') ?? 1;
    speedBtn.textContent = `${audio.playbackRate}×`;
    syncButtons();
  });
  audio.addEventListener('pause', () => {
    savePosition();
    syncButtons();
  });
  audio.addEventListener('loadedmetadata', () => {
    range.max = String(Math.floor(audio.duration));
    total.textContent = formatTimestamp(audio.duration);
    renderMarkers();
  });
  audio.addEventListener('timeupdate', () => {
    range.value = String(Math.floor(audio.currentTime));
    current.textContent = formatTimestamp(audio.currentTime);
    updateChapter();
    if (Math.abs(audio.currentTime - lastSaved) > 5) {
      lastSaved = audio.currentTime;
      savePosition();
    }
  });
  audio.addEventListener('ended', () => store.set(`pos:${track?.id}`, 0));
  window.addEventListener('pagehide', savePosition);
  document.addEventListener('astro:page-load', syncButtons);

  // Siden får luft nederst tilsvarende avspillerens høyde, som endres når den brytes over flere linjer.
  new ResizeObserver(() => {
    document.documentElement.style.setProperty('--player-h', `${root.offsetHeight}px`);
  }).observe(root);

  // Vis forrige episode (pauset) når siden lastes på nytt.
  const previous = store.get<Track>('current');
  if (previous) load({ ...previous, duration: previous.duration ?? 0, chapters: previous.chapters ?? [] });
</script>

<style>
  .player {
    position: fixed; inset: auto 0 0 0; z-index: 20;
    display: flex; align-items: center; gap: 14px;
    padding: 10px max(16px, calc((100% - var(--max)) / 2));
    --text: var(--player-text);
    --muted: var(--player-muted);
    --surface-2: var(--player-hover);
    background: var(--player-bg);
    color: var(--text);
    border-top: 2px solid var(--red);
    box-shadow: 0 -8px 24px rgb(0 0 0 / 0.35);
    view-transition-name: player;
  }
  .player[hidden] { display: none; }
  .cover img { width: 56px; height: 56px; border-radius: 8px; object-fit: cover; }
  .info { flex: 1; min-width: 0; }
  .heading { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .title {
    flex-shrink: 0; max-width: 60%; color: var(--text); font-weight: 650; text-decoration: none;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .chapter {
    min-width: 0; font-size: 0.85rem; color: var(--muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .chapter:not(:empty)::before { content: '·'; margin-right: 10px; }
  .scrub { display: flex; align-items: center; gap: 10px; }
  .track { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; }
  .track input { width: 100%; margin: 0; accent-color: var(--red); }
  .markers { position: absolute; inset: 0 8px; pointer-events: none; }
  .markers :global(span) {
    position: absolute; top: 50%; width: 2px; height: 10px; translate: -1px -50%;
    background: var(--text); opacity: 0.45; border-radius: 1px;
  }
  /* Fast bredde, så ingenting flytter seg når tiden eller hastigheten endres. */
  .time { width: 4.2em; font-size: 0.8rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  [data-current] { text-align: right; }
  .controls { display: flex; align-items: center; gap: 6px; }
  .controls button {
    border: 0; background: transparent; padding: 8px; border-radius: 999px;
    font-size: 0.85rem; font-weight: 600; color: var(--muted);
  }
  .controls button:hover { color: var(--text); background: var(--surface-2); }
  .controls .toggle { background: var(--red); color: var(--accent-ink); display: grid; place-items: center; width: 44px; height: 44px; }
  .controls .toggle:hover { background: var(--red-hover); color: var(--accent-ink); }
  .speed { width: 3.8em; font-variant-numeric: tabular-nums; }

  .chapters-menu { position: relative; display: flex; }
  .chapters-toggle { display: grid; place-items: center; }
  .chapters-toggle[hidden] { display: none; }
  .chapters-toggle svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .chapters-toggle[aria-expanded='true'] { color: var(--text); background: var(--surface-2); }
  .chapter-list {
    position: absolute; right: 0; bottom: calc(100% + 14px); width: min(340px, calc(100vw - 32px));
    max-height: 50vh; overflow-y: auto; margin: 0; padding: 6px; list-style: none;
    background: var(--player-bg); border: 1px solid rgb(0 0 0 / 0.15); border-radius: var(--radius);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.4);
  }
  .chapter-list[hidden] { display: none; }
  .chapter-list :global(button) {
    display: flex; gap: 12px; width: 100%; text-align: left; padding: 8px 10px;
    border: 0; border-radius: 8px; background: transparent; color: var(--text); font-size: 0.9rem;
  }
  .chapter-list :global(button:hover) { background: var(--surface-2); }
  .chapter-list :global(button.is-active) { font-weight: 650; box-shadow: inset 3px 0 0 var(--red); }
  .chapter-list :global(.ts) { min-width: 4.2em; color: var(--muted); font-variant-numeric: tabular-nums; }

  @media (max-width: 640px) {
    .player { flex-wrap: wrap; gap: 8px 12px; }
    .cover img { width: 44px; height: 44px; }
    .info { flex-basis: calc(100% - 60px); }
    .controls { width: 100%; justify-content: center; }
    .chapter-list { position: fixed; left: 16px; right: 16px; width: auto; bottom: calc(var(--player-h) + 8px); }
  }
</style>
