---
import PlayPauseIcon from './PlayPauseIcon.astro';

/*
 * Avspilleren ligger nederst og overlever sidebytter (transition:persist).
 * Alle elementer med data-play starter en episode:
 *   data-play="<id>" data-src data-title data-image data-href data-duration [data-chapters=JSON] [data-start=sekunder]
 * Attributtene lages av playData() og leses av readTrack()/readStart() i src/lib/play.ts,
 * og markPlaying() der bestemmer hvordan hver knapp viser at den spiller.
 * Kapitler, volum og plassen avspilleren tar nederst på siden ligger i src/lib/player/.
 */
---

<div id="player" class="player" transition:persist hidden>
  <audio preload="none"></audio>
  <div class="bar" data-bar>
    <div class="now">
      <a class="cover" data-link tabindex="-1" aria-hidden="true">
        <img data-cover alt="" width="56" height="56" />
        <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
      </a>
      <div class="text">
        <a class="title" data-link></a>
        <span class="chapter" data-chapter></span>
      </div>
    </div>

    <div class="center">
      <div class="controls">
        <button type="button" data-skip="-15" aria-label="Spol 15 sekunder tilbake">−15</button>
        <button type="button" class="toggle" data-toggle aria-label="Spill av">
          <PlayPauseIcon size={24} />
        </button>
        <button type="button" data-skip="30" aria-label="Spol 30 sekunder frem">+30</button>
      </div>
      <div class="scrub">
        <span class="time" data-current>0:00</span>
        <div class="track">
          <input type="range" min="0" max="0" step="1" value="0" aria-label="Posisjon i episoden" />
          <div class="markers" data-markers aria-hidden="true"></div>
          <div class="hover-tip" data-hover-tip aria-hidden="true" hidden></div>
        </div>
        <span class="time" data-duration>0:00</span>
      </div>
    </div>

    <div class="side">
      <div class="chapters-menu">
        <button type="button" class="chapters-toggle" data-chapters-toggle aria-label="Kapitler" aria-expanded="false" aria-controls="player-chapters" hidden>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
        </button>
        <ol class="chapter-list" id="player-chapters" data-chapter-list hidden></ol>
      </div>
      <div class="volume" data-volume>
        <button type="button" class="mute" data-mute aria-label="Slå av lyden">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path class="speaker" d="M11 5 6 9H2v6h4l5 4z" />
            <path class="waves" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9.5 9.5 0 0 1 0 13" />
            <path class="cross" d="m16 9 6 6m0-6-6 6" />
          </svg>
        </button>
        <input type="range" min="0" max="1" step="0.05" value="1" data-volume-range aria-label="Volum" />
      </div>
      <button type="button" class="speed" data-speed aria-label="Avspillingshastighet">1×</button>
      <button type="button" class="minimize" data-minimize aria-label="Minimer avspilleren">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </button>
      <button type="button" class="close" data-close aria-label="Lukk avspilleren">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>

  <!-- Minimert: bare coverbildet nede til høyre, med lydbølger når noe spilles. -->
  <button type="button" class="mini" data-expand aria-label="Vis avspilleren">
    <img data-cover alt="" width="64" height="64" />
    <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>
</div>

<script>
  import { formatTimestamp } from '../lib/format';
  import { markPlaying, readStart, readTrack, type Track } from '../lib/play';
  import { setupChapters } from '../lib/player/chapters';
  import { olderTrack } from '../lib/player/queue';
  import { trackPlayerSpace } from '../lib/player/space';
  import { setupVolume } from '../lib/player/volume';
  import { store } from '../lib/storage';
  import { withViewTransition } from '../lib/transition';

  const SPEEDS = [1, 1.25, 1.5, 1.75, 2];

  const root = document.getElementById('player')!;
  const audio = root.querySelector('audio')!;
  const range = root.querySelector<HTMLInputElement>('.scrub input[type=range]')!;
  const current = root.querySelector<HTMLElement>('[data-current]')!;
  const total = root.querySelector<HTMLElement>('[data-duration]')!;
  const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
  const speedBtn = root.querySelector<HTMLButtonElement>('[data-speed]')!;
  const bar = root.querySelector<HTMLElement>('[data-bar]')!;
  const minimizeBtn = root.querySelector<HTMLButtonElement>('[data-minimize]')!;
  const expandBtn = root.querySelector<HTMLButtonElement>('[data-expand]')!;
  const closeBtn = root.querySelector<HTMLButtonElement>('[data-close]')!;
  let track: Track | null = null;
  let lastSaved = 0;

  const chapters = setupChapters(root, audio);
  setupVolume(root, audio);
  trackPlayerSpace(bar, expandBtn);

  function savePosition() {
    if (track) store.set(`pos:${track.id}`, Math.floor(audio.currentTime));
  }

  // Viser avspilleren når en episode er lastet og skjuler den ellers. Den glir opp når den åpnes og
  // ned når den lukkes (player-open/player-close i global.css). Oppdateringen leser track først når
  // den kjører, så en episode som startes rett etter lukking ikke blir skjult.
  function syncVisible(animate = true) {
    if (root.hidden === !track) return;
    const update = () => {
      root.hidden = !track;
      if (!track) root.classList.remove('is-minimized');
    };
    if (animate) withViewTransition(update, track ? 'player-open' : 'player-close');
    else update();
  }

  function load(next: Track, start?: number, animate = true) {
    if (track?.id !== next.id) {
      savePosition();
      track = next;
      audio.src = next.src;
      store.set('current', next);
      root.querySelectorAll<HTMLImageElement>('[data-cover]').forEach((img) => (img.src = next.image));
      root.querySelectorAll<HTMLAnchorElement>('[data-link]').forEach((a) => (a.href = next.href));
      root.querySelector('.title')!.textContent = next.title;
      range.max = String(next.duration);
      total.textContent = formatTimestamp(next.duration);
      chapters.show(next);
      syncVisible(animate);
      const resumeAt = start ?? store.get<number>(`pos:${next.id}`) ?? 0;
      range.value = String(resumeAt);
      current.textContent = formatTimestamp(resumeAt);
      chapters.update(resumeAt);
      audio.addEventListener('loadedmetadata', () => (audio.currentTime = resumeAt), { once: true });
    } else if (start !== undefined) {
      audio.currentTime = start;
    }
  }

  function setMinimized(minimized: boolean, animate = true) {
    const update = () => {
      root.classList.toggle('is-minimized', minimized);
      chapters.close();
    };
    store.set('minimized', minimized);
    if (!animate) return update();
    const done = () => (minimized ? expandBtn : minimizeBtn).focus({ preventScroll: true });
    const transition = withViewTransition(update, 'player');
    if (transition) transition.updateCallbackDone.then(done);
    else done();
  }

  // Stopper avspillingen og fjerner avspilleren. Posisjonen i episoden huskes til neste gang.
  function close() {
    audio.pause();
    savePosition();
    track = null;
    audio.removeAttribute('src');
    audio.load();
    store.set('current', null);
    chapters.close();
    syncVisible();
    store.set('minimized', false);
    syncButtons();
  }

  // Ringen rundt play/pause vises mens lyden lastes, før start eller når den må bufre underveis.
  function setLoading(loading: boolean) {
    root.classList.toggle('is-loading', loading);
    toggle.toggleAttribute('aria-busy', loading);
  }

  function togglePlayback() {
    if (audio.paused) audio.play();
    else audio.pause();
  }

  function syncButtons() {
    const playing = !audio.paused;
    root.classList.toggle('is-playing', playing);
    toggle.setAttribute('aria-label', playing ? 'Pause' : 'Spill av');
    document
      .querySelectorAll<HTMLElement>('[data-play]')
      .forEach((el) => markPlaying(el, playing && el.dataset.play === track?.id));
  }

  document.addEventListener('click', (e) => {
    const el = (e.target as Element).closest<HTMLElement>('[data-play]');
    if (!el) return;
    e.preventDefault();
    const start = readStart(el.dataset);
    if (el.dataset.play === track?.id && start === undefined) return togglePlayback();
    load(readTrack(el.dataset), start);
    audio.play();
  });

  toggle.addEventListener('click', togglePlayback);
  root.querySelectorAll<HTMLButtonElement>('[data-skip]').forEach((b) =>
    b.addEventListener('click', () => (audio.currentTime += Number(b.dataset.skip))),
  );
  speedBtn.addEventListener('click', () => {
    const next = SPEEDS[(SPEEDS.indexOf(audio.playbackRate) + 1) % SPEEDS.length];
    audio.playbackRate = next;
    speedBtn.textContent = `${next}×`;
    store.set('speed', next);
  });
  range.addEventListener('input', () => (audio.currentTime = Number(range.value)));
  minimizeBtn.addEventListener('click', () => setMinimized(true));
  expandBtn.addEventListener('click', () => setMinimized(false));
  closeBtn.addEventListener('click', close);

  audio.addEventListener('play', () => {
    audio.playbackRate = store.get<number>('speed') ?? 1;
    speedBtn.textContent = `${audio.playbackRate}×`;
    setLoading(audio.readyState < audio.HAVE_FUTURE_DATA);
    syncButtons();
  });
  audio.addEventListener('waiting', () => setLoading(true));
  for (const type of ['playing', 'pause', 'error', 'emptied']) audio.addEventListener(type, () => setLoading(false));
  audio.addEventListener('pause', () => {
    savePosition();
    syncButtons();
  });
  audio.addEventListener('loadedmetadata', () => {
    range.max = String(Math.floor(audio.duration));
    total.textContent = formatTimestamp(audio.duration);
  });
  audio.addEventListener('timeupdate', () => {
    range.value = String(Math.floor(audio.currentTime));
    current.textContent = formatTimestamp(audio.currentTime);
    chapters.update();
    if (Math.abs(audio.currentTime - lastSaved) > 5) {
      lastSaved = audio.currentTime;
      savePosition();
    }
  });
  // Når en episode er ferdig, spilles den forrige (eldre) av, med mindre noe annet er startet i mellomtiden.
  audio.addEventListener('ended', async () => {
    if (!track) return;
    const finished = track.id;
    store.set(`pos:${finished}`, 0);
    const next = await olderTrack(finished);
    if (!next || track?.id !== finished || !audio.ended) return;
    load(next);
    audio.play();
  });
  window.addEventListener('pagehide', savePosition);
  document.addEventListener('astro:page-load', syncButtons);

  if (store.get<boolean>('minimized')) setMinimized(true, false);

  // Vis forrige episode (pauset) når siden lastes på nytt.
  const previous = store.get<Track>('current');
  if (previous) load({ ...previous, duration: previous.duration ?? 0, chapters: previous.chapters ?? [] }, undefined, false);
</script>

<style>
  .player {
    --text: var(--player-text);
    --muted: var(--player-muted);
    --surface-2: var(--player-hover);
    color: var(--text);
    color-scheme: var(--player-scheme);
  }
  .bar {
    position: fixed; inset: auto 0 0 0; z-index: 20;
    display: grid; align-items: center; gap: 8px 24px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px) minmax(0, 1fr);
    grid-template-areas: 'now center side';
    padding: 10px max(16px, calc((100% - var(--max)) / 2));
    background: var(--player-bg);
    border-top: 2px solid var(--red);
    box-shadow: 0 -8px 24px rgb(0 0 0 / 0.35);
    view-transition-name: player;
  }
  .is-minimized .bar { display: none; }

  /* Venstre: bilde, tittel og kapittel. */
  .now { grid-area: now; display: flex; align-items: center; gap: 12px; min-width: 0; }
  .cover { position: relative; flex-shrink: 0; }
  /* Samme lydbølger som i minimert visning, men bare synlige mens lyden spiller. */
  .cover .eq {
    --eq-max: 10px; right: -5px; bottom: -5px; height: 20px; padding: 4px 5px;
    opacity: 0; scale: 0.5; transition: opacity 0.2s ease, scale 0.2s ease;
  }
  .is-playing .cover .eq { opacity: 1; scale: 1; }
  .cover img { width: 56px; height: 56px; border-radius: 8px; object-fit: cover; }
  .text { display: flex; flex-direction: column; min-width: 0; }
  .title, .chapter { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .title { color: var(--text); font-weight: 650; text-decoration: none; }
  .title:hover { color: var(--accent); }
  .chapter { font-size: 0.85rem; color: var(--muted); }

  /* Midten: knapper over tidslinja. */
  .center { grid-area: center; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .controls { display: flex; justify-content: center; align-items: center; gap: 8px; }
  .scrub { display: flex; align-items: center; gap: 10px; }
  .track { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; }
  .track input { width: 100%; margin: 0; accent-color: var(--red); }
  .markers { position: absolute; inset: 0 8px; pointer-events: none; }
  .markers :global(span) {
    position: absolute; top: 50%; width: 3px; height: 14px; translate: -1.5px -50%;
    background: var(--text); opacity: 0.8; border-radius: 2px;
    /* Kant i bakgrunnsfargen, så markøren synes både over spilt og uspilt del. */
    box-shadow: 0 0 0 1px var(--player-edge);
  }
  .hover-tip {
    position: absolute; bottom: calc(100% + 8px); translate: -50% 0; z-index: 1;
    max-width: min(320px, 100%); padding: 4px 10px; border-radius: 8px; pointer-events: none;
    background: var(--text); color: var(--player-edge); font-size: 0.8rem; font-weight: 600;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);
  }
  .hover-tip[hidden] { display: none; }
  /* Fast bredde, så ingenting flytter seg når tiden eller hastigheten endres. */
  .time { width: 4.2em; font-size: 0.8rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  [data-current] { text-align: right; }
  .bar button {
    border: 0; background: transparent; padding: 8px; border-radius: 999px;
    font-size: 0.85rem; font-weight: 600; color: var(--muted);
  }
  .bar button:hover { color: var(--text); background: var(--surface-2); }
  .bar .toggle { background: var(--red); color: var(--accent-ink); display: grid; place-items: center; width: 40px; height: 40px; }
  .bar .toggle:hover { background: var(--red-hover); color: var(--accent-ink); }
  /* Lasteringen. Den kommer litt forsinket, så den ikke blinker når lyden starter med en gang. */
  .bar .toggle { position: relative; }
  .bar .toggle::after {
    content: ''; position: absolute; inset: -4px; border-radius: 50%; pointer-events: none;
    border: 2px solid transparent; border-top-color: var(--red); border-right-color: var(--red);
    opacity: 0; transition: opacity 0.15s;
  }
  .is-loading .bar .toggle::after { opacity: 1; transition-delay: 0.2s; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { rotate: 1turn; } }

  /* Høyre: kapitler, volum, hastighet og minimer. */
  .side { grid-area: side; display: flex; justify-content: flex-end; align-items: center; gap: 4px; }
  .volume { display: flex; align-items: center; }
  .mute { display: grid; place-items: center; }
  .mute svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .mute .speaker { fill: currentColor; }
  .mute .cross, .is-muted .mute .waves { display: none; }
  .is-muted .mute .cross { display: inline; }
  .volume input { width: 84px; margin: 0 6px 0 0; accent-color: var(--red); }
  .speed { width: 3.8em; font-variant-numeric: tabular-nums; }
  .minimize, .close { display: grid; place-items: center; }
  .minimize svg, .close svg { fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }

  .chapters-menu { position: relative; display: flex; }
  .chapters-toggle { display: grid; place-items: center; }
  .chapters-toggle[hidden] { display: none; }
  .chapters-toggle svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .chapters-toggle[aria-expanded='true'] { color: var(--text); background: var(--surface-2); }
  .chapter-list {
    position: absolute; right: 0; bottom: calc(100% + 14px); width: min(340px, calc(100vw - 32px));
    max-height: 50vh; overflow-y: auto; margin: 0; padding: 6px; list-style: none;
    background: var(--player-bg); border: 1px solid rgb(0 0 0 / 0.15); border-radius: var(--radius);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.4);
  }
  .chapter-list[hidden] { display: none; }
  .chapter-list :global(button) {
    display: flex; gap: 12px; width: 100%; text-align: left; padding: 8px 10px;
    border: 0; border-radius: 8px; background: transparent; color: var(--text); font-size: 0.9rem;
  }
  .chapter-list :global(button:hover) { background: var(--surface-2); }
  .chapter-list :global(button.is-active) { font-weight: 650; box-shadow: inset 3px 0 0 var(--red); }
  .chapter-list :global(.ts) { min-width: 4.2em; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* Minimert avspiller: coverbilde nede til høyre. */
  .mini {
    display: none; position: fixed; right: 16px; bottom: 16px; z-index: 20;
    width: 64px; height: 64px; padding: 0; border: 2px solid var(--red); border-radius: 16px;
    background: var(--player-bg); box-shadow: 0 8px 24px rgb(0 0 0 / 0.45); cursor: pointer;
    view-transition-name: player;
  }
  .is-minimized .mini { display: block; }
  .mini img { width: 100%; height: 100%; border-radius: 14px; object-fit: cover; }
  .mini:hover { scale: 1.05; }
  .mini:focus-visible { outline-offset: 3px; }
  .eq {
    position: absolute; right: -6px; bottom: -6px; display: flex; align-items: flex-end; gap: 2px;
    height: 24px; padding: 5px 6px; border-radius: 999px; background: var(--red);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.4);
  }
  .eq i { width: 3px; height: 4px; border-radius: 1px; background: #fff; }
  /* Søylene beveger seg bare når lyden spiller. */
  .is-playing .eq i { animation: eq 0.9s ease-in-out infinite alternate; }
  .is-playing .eq i:nth-child(2) { animation-delay: -0.3s; }
  .is-playing .eq i:nth-child(3) { animation-delay: -0.6s; }
  @keyframes eq { from { height: 3px; } to { height: var(--eq-max, 14px); } }
  @media (prefers-reduced-motion: reduce) {
    .is-playing .eq i { animation: none; height: 10px; }
  }

  /*
   * Mobil: alle knapper legges i ett felles rutenett med fem like kolonner.
   * Rad 1: bilde og tittel, minimer, lukk. Rad 2: kapitler, −15, play, +30, hastighet. Rad 3: tidslinja.
   */
  @media (max-width: 760px) {
    .bar {
      grid-template-columns: repeat(5, minmax(0, 1fr)); grid-template-areas: none; gap: 2px 0;
      padding: 8px 12px max(6px, env(safe-area-inset-bottom));
    }
    .center, .controls, .side { display: contents; }
    .bar > * , .controls > *, .side > * { justify-self: center; }
    /* .bar > .now, så den slår .bar > * over; ellers sentreres den og lange titler flyter over minimer. */
    .bar > .now { grid-column: 1 / 4; grid-row: 1; justify-self: stretch; }
    .minimize { grid-column: 4; grid-row: 1; }
    .close { grid-column: 5; grid-row: 1; }
    .chapters-menu { grid-column: 1; grid-row: 2; }
    [data-skip='-15'] { grid-column: 2; grid-row: 2; }
    .toggle { grid-column: 3; grid-row: 2; }
    [data-skip='30'] { grid-column: 4; grid-row: 2; }
    .speed { grid-column: 5; grid-row: 2; }
    /* Telefoner har egne volumknapper, og iOS lar ikke siden styre volumet. */
    .volume { display: none; }
    .scrub { grid-column: 1 / -1; grid-row: 3; justify-self: stretch; }
    .bar button { min-width: 40px; min-height: 40px; }
    .cover img { width: 40px; height: 40px; }
    .mini { bottom: max(16px, env(safe-area-inset-bottom)); }
    .chapter-list { position: fixed; left: 16px; right: 16px; width: auto; bottom: calc(var(--player-h) + 8px); }
  }
</style>
